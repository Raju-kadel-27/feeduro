{
  "name": "@feeduro/web",
  "private": true,
  "type": "module",
  "scripts": {
    "make": "make",
    "dev": "dotenv -e .env -- vite dev",
    "dev:tunnel": "TUNNEL=true dotenv -e .env -- vite dev",
    "build": "react-router build",
    "start": "vite preview",
    "deploy": "pnpm run build && wrangler deploy --env=\"\"",
    "build:staging": "CLOUDFLARE_ENV=staging react-router build",
    "build:production": "CLOUDFLARE_ENV=production react-router build",
    "deploy:staging": "pnpm run build:staging && wrangler types && wrangler deploy --env staging",
    "deploy:production": "wrangler types && wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "typecheck": "pnpm rr:typegen && pnpm cf:typegen && tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "rm -rf build dist .nx",
    "test": "echo 'No tests yet'",
    "rr:typegen": "react-router typegen",
    "rr:routes": "react-router routes",
    "cf:typegen": "wrangler types",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "db:push": "dotenv -e .env -- drizzle-kit push --config=./db/config.ts",
    "db:migrate": "pnpm run db:generate && dotenv -e .env -- drizzle-kit migrate --config=./db/config.ts",
    "db:studio": "dotenv -e .env -- drizzle-kit studio --config=./db/config.ts",
    "db:generate": "drizzle-kit generate --config=./db/config.ts",
    "db:seed": "dotenv -e .env -- tsx db/seed.ts",
    "db:nuke": "dotenv -e .env -- tsx db/nuke.ts",
    "schema:generate": "dotenv -e .env -- npx @better-auth/cli@latest generate --config ./app/lib/auth/server.ts --output ./db/schema/better-auth.ts --yes",
    "dodo:login": "dodo login",
    "dodo:webhook": "NODE_OPTIONS=--experimental-websocket NODE_TLS_REJECT_UNAUTHORIZED=0 dodo wh listen --forward-to https://localhost:3000/api/auth/dodopayments/webhooks",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.18",
    "@better-auth/oauth-provider": "^1.6.18",
    "@better-auth/passkey": "^1.6.18",
    "@better-auth/sso": "^1.6.18",
    "@dnd-kit/abstract": "^0.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/helpers": "^0.4.0",
    "@dnd-kit/react": "^0.4.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dodopayments/better-auth": "^1.6.2",
    "@faker-js/faker": "^10.4.0",
    "@feeduro/errors": "workspace:*",
    "@hookform/resolvers": "^3.10.0",
    "@legendapp/state": "3.0.0-beta.30",
    "@neondatabase/serverless": "^0.10.4",
    "@paralleldrive/cuid2": "^2.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-router/cloudflare": "^7.10.0",
    "@react-router/node": "7.14.0",
    "@react-router/serve": "7.14.0",
    "@tanstack/react-query": "^5.90.9",
    "@tanstack/react-table": "^8.21.3",
    "@types/qrcode": "^1.5.6",
    "better-auth": "^1.6.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dodopayments": "^2.29.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "i18next": "^26.0.8",
    "input-otp": "^1.4.2",
    "isbot": "^5.1.36",
    "lucide-react": "^1.11.0",
    "nodemailer": "^8.0.6",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.73.1",
    "react-i18next": "^17.0.4",
    "react-router": "7.14.0",
    "react-router-dom": "7.14.0",
    "recharts": "2.15.4",
    "resend": "^6.12.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "unique-names-generator": "^4.7.1",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cloudflare/vite-plugin": "^1.8.0",
    "@cloudflare/workers-types": "^4.20251202.0",
    "@react-router/dev": "7.14.0",
    "@react-router/remix-routes-option-adapter": "^7.8.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "2.1.0",
    "autoprefixer": "10.4.19",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^7.4.2",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "pg": "^8.20.0",
    "postcss": "8.4.38",
    "remix-flat-routes": "^0.8.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-babel": "^1.7.1",
    "wrangler": "^4.35.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.3.6"
    }
  }
}
