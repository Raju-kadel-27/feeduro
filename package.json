{
  "name": "feediyo",
  "private": true,
  "type": "module",
  "scripts": {
    "make": "bash dev.sh",
    "dev": "dotenv -e .env.dev -- vite dev",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "wrangler deploy",
    "build:staging": "CLOUDFLARE_ENV=staging react-router build",
    "build:production": "CLOUDFLARE_ENV=production react-router build",
    "deploy:staging": "pnpm run build && wrangler deploy --env staging",
    "deploy:prod": "pnpm run build:prod && wrangler deploy --env production",
    "typecheck": "pnpm rr:typegen && pnpm cf:typegen && tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "rm -rf build dist .nx",
    "test": "echo 'No tests yet'",
    "rr:typegen": "react-router typegen",
    "rr:routes": "react-router routes",
    "cf:typegen": "wrangler types",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file .env.dev up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file .env.dev down",
    "db:up": "docker compose -f docker/docker-compose.yml --env-file .env up db -d",
    "db:down": "docker compose -f docker/docker-compose.yml --env-file .env down -v",
    "db:push": "dotenv -e .env.dev -- drizzle-kit push --config=./db/config.ts",
    "db:migrate": "pnpm run db:generate && dotenv -e .env.dev -- drizzle-kit migrate --config=./db/config.ts",
    "db:studio": "dotenv -e .env.dev -- drizzle-kit studio --config=./db/config.ts",
    "db:generate": "drizzle-kit generate --config=./db/config.ts",
    "db:seed": "dotenv -e .env.dev -- tsx db/seed.ts",
    "schema:generate": "dotenv -e .env -- npx @better-auth/cli@latest generate --config ./app/lib/auth/server.ts --output ./db/schema/better-auth.ts --yes",
    "stripe:webhook": "stripe listen --forward-to localhost:3000/api/auth/stripe/webhook",
    "dodo:login": "dodo login",
    "dodo:webhook": "NODE_OPTIONS=--experimental-websocket dodo wh listen --forward-to localhost:3000/api/auth/dodopayments/webhooks",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.9",
    "@better-auth/passkey": "^1.6.5",
    "@better-auth/sso": "^1.6.9",
    "@better-auth/stripe": "^1.6.5",
    "@blocknote/core": "^0.49.0",
    "@blocknote/react": "^0.49.0",
    "@blocknote/shadcn": "^0.49.0",
    "@dnd-kit/abstract": "^0.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/helpers": "^0.4.0",
    "@dnd-kit/react": "^0.4.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dodopayments/better-auth": "^1.6.2",
    "@legendapp/state": "3.0.0-beta.30",
    "@neondatabase/serverless": "^0.10.4",
    "@paralleldrive/cuid2": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.7",
    "@react-email/tailwind": "^2.0.7",
    "@react-router/cloudflare": "^7.10.0",
    "@react-router/node": "7.14.0",
    "@react-router/serve": "7.14.0",
    "@tanstack/react-query": "^5.90.9",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dodopayments": "^2.29.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "i18next": "^26.0.8",
    "isbot": "^5.1.36",
    "lucide-react": "^1.8.0",
    "nodemailer": "^8.0.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.73.1",
    "react-i18next": "^17.0.4",
    "react-router": "7.14.0",
    "resend": "^6.12.2",
    "sonner": "^2.0.7",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cloudflare/vite-plugin": "^1.12.4",
    "@cloudflare/workers-types": "^4.20251202.0",
    "@react-router/dev": "7.14.0",
    "@react-router/remix-routes-option-adapter": "^7.8.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "2.1.0",
    "autoprefixer": "10.4.19",
    "dodopayments-cli": "^2.2.0",
    "dotenv-cli": "^7.4.2",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "pg": "^8.20.0",
    "postcss": "8.4.38",
    "remix-flat-routes": "^0.8.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.35.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.3.6"
    }
  }
}
