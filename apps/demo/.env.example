# Board embed tokens — copy from Settings > Widget in your Feeduro workspace
FEEDURO_WIDGET_TOKEN_FEATURE=your_board_token_here
FEEDURO_WIDGET_TOKEN_INTEGRATIONS=your_board_token_here
FEEDURO_WIDGET_TOKEN_BUGS=your_board_token_here

# REST API key — copy from Settings > API Keys in your Feeduro workspace
FEEDURO_API_KEY=fdy_live_...

# Webhook signing secret — shown once when you create a webhook endpoint
FEEDURO_WEBHOOK_SECRET=your_signing_secret_here

# Feeduro API base URL (for local dev point at the web app dev server)
FEEDURO_API_URL=http://localhost:3000

# Base URL of this demo app — used for OAuth redirect URIs
# Local dev (default): http://localhost:3001
# Tunnel (run `pnpm dev:tunnel`): set to your static ngrok domain
# BASE_URL=https://your-word.ngrok-free.app
