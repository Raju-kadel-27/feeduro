{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "paths": {
      "@feeduro/db": ["../db/src/index.ts"],
      "@feeduro/db/schema": ["../db/src/schema/index.ts"],
      "@lib/*": ["../../apps/web/app/lib/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
