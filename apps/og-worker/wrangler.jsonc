{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "feeduro-og",
  "main": "./src/index.ts",
  "compatibility_date": "2025-04-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "env": {
    "staging": {
      "name": "feeduro-og-staging"
    },
    "production": {
      "name": "feeduro-og-production"
    }
  }
}
