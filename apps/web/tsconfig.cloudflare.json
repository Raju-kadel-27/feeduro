{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "db/**/*",
    "worker-configuration.d.ts",
    "env-augments.d.ts",
    "react-router.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["@total-typescript/ts-reset", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./*"],
      "~/*": ["./app/*"],
      "@components/*": ["./app/components/*"],
      "@providers/*": ["./app/providers/*"],
      "@hooks/*": ["./app/hooks/*"],
      "@lib/*": ["./app/lib/*"],
      "@utils/*": ["./app/utils/*"],
      "@routes/*": ["./app/routes/*"],
      "@emails/*": ["./app/features/emails/*"],
      "@jobs/*": ["./app/features/internal/jobs/*"],
      "@db/*": ["./db/*"],
      "@styles/*": ["./styles/*"],
      "@middleware/*": ["./app/middleware/*"],
      "@features/*": ["./app/features/*"],
      "@services/*": ["./app/services/*"]
    }
  }
}
