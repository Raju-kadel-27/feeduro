# Widget token — copy from Settings > Widget in your Feeduro workspace
FEEDURO_WIDGET_TOKEN=your_widget_token_here

# REST API key — copy from Settings > API Keys in your Feeduro workspace
FEEDURO_API_KEY=fdy_live_...

# Webhook signing secret — shown once when you create a webhook endpoint
FEEDURO_WEBHOOK_SECRET=your_signing_secret_here

# Feeduro API base URL (for local dev point at the web app dev server)
FEEDURO_API_URL=http://localhost:3000

# Ngrok tunnel — expose the demo app via a static domain (run `pnpm dev:tunnel`)
# Get a free static domain: ngrok.com/dashboard → Domains → + New Domain
# When set, FEEDURO_OAUTH_REDIRECT_URI automatically uses https://<domain>/oauth/callback
# NGROK_DOMAIN=your-word.ngrok-free.app
