{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "build:staging": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "build:production": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "deploy:preview": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN"]
    },
    "deploy:production": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": []
    }
  }
}
