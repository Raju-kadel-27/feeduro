# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feediyo

ENVIRONMENT=development

# Must be http:// in local dev — https:// makes Better Auth set Secure cookies
# which browsers silently drop on an http:// origin
BASE_URL=http://localhost:3000

# Tunnel — run `make` or `pnpm dev:tunnel` to expose localhost via ngrok
# Get a free static domain: ngrok.com/dashboard → Domains → + New Domain
# Then: ngrok config add-authtoken YOUR_TOKEN
# NGROK_DOMAIN=your-word.ngrok-free.app

# Required: min 32 chars — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret!!

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Discord OAuth — https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Slack OAuth — https://api.slack.com/apps
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Jira OAuth — https://developer.atlassian.com/console/myapps/
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret

# Linear OAuth — https://linear.app/settings/api
LINEAR_CLIENT_ID=your_linear_client_id
LINEAR_CLIENT_SECRET=your_linear_client_secret
LINEAR_WEBHOOK_SECRET=your_linear_webhook_secret

# Asana OAuth — https://app.asana.com/0/developer-console
ASANA_CLIENT_ID=your_asana_client_id
ASANA_CLIENT_SECRET=your_asana_client_secret

# Notion OAuth — https://www.notion.so/my-integrations
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret

# Monday.com OAuth — https://developer.monday.com/apps
MONDAY_CLIENT_ID=your_monday_client_id
MONDAY_CLIENT_SECRET=your_monday_client_secret
MONDAY_SIGNING_SECRET=your_monday_signing_secret

# Trello — https://trello.com/power-ups/admin
TRELLO_API_KEY=your_trello_api_key
TRELLO_API_SECRET=your_trello_api_secret
TRELLO_SIGNING_SECRET=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dodo Payments — https://dashboard.dodopayments.com
# Dashboard → Developer → API Keys
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key
# Dashboard → Developer → Webhooks → create endpoint for /api/auth/dodopayments/webhooks
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Product IDs — Dashboard → Products (starts with pdt_)
DODO_STARTER_MONTHLY_PRODUCT_ID=pdt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DODO_STARTER_ANNUAL_PRODUCT_ID=pdt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DODO_PRO_MONTHLY_PRODUCT_ID=pdt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DODO_PRO_ANNUAL_PRODUCT_ID=pdt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

PLATFORM_ADMIN_USER_IDS=xxxxxxxxxxxxxxxxxxxxxxx
