# Widget token — copy from Settings > Widget in your Feediyo workspace
FEEDIYO_WIDGET_TOKEN=your_widget_token_here

# REST API key — copy from Settings > API Keys in your Feediyo workspace
FEEDIYO_API_KEY=fdy_live_...

# Webhook signing secret — shown once when you create a webhook endpoint
FEEDIYO_WEBHOOK_SECRET=your_signing_secret_here

# Feediyo API base URL (for local dev point at the web app dev server)
FEEDIYO_API_URL=http://localhost:3000
