{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "types": ["./worker-configuration.d.ts", "node"],
    "paths": {
      "@feeduro/db": ["../../packages/db/src/index.ts"],
      "@feeduro/db/schema": ["../../packages/db/src/schema/index.ts"],
      "@feeduro/errors": ["../../packages/errors/src/index.ts"],
      "@feeduro/data-access/*": ["../../packages/data-access/src/*"]
    }
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
