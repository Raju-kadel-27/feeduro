{
  "name": "feeduro-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo dev --filter=@feeduro/web",
    "build": "turbo build",
    "build:staging": "turbo run build:staging --filter=@feeduro/web",
    "build:production": "turbo run build:production --filter=@feeduro/web",
    "deploy:preview": "turbo run deploy:preview --filter=@feeduro/web",
    "deploy:production": "turbo run deploy:production --filter=@feeduro/web",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky"
  },
  "pnpm": {
    "patchedDependencies": {
      "@remix-run/node-fetch-server@0.13.0": "patches/@remix-run__node-fetch-server@0.13.0.patch"
    }
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.4.3"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "husky": "^9.1.7",
    "turbo": "latest"
  }
}
